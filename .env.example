# Copy to .env:  cp .env.example .env
# Every value here is a development default. Generate real secrets for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres (used by the postgres container and by the api/worker) ---
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener
POSTGRES_DB=shortener
# Host is "localhost" when running the API outside Docker; docker-compose overrides it to "postgres".
DATABASE_URL=postgresql+asyncpg://shortener:shortener@localhost:5432/shortener

# --- Redis ---
# docker-compose overrides the host to "redis".
REDIS_URL=redis://localhost:6379/0

# --- Security (CHANGE BOTH in any shared or production environment) ---
JWT_SECRET_KEY=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
ACCESS_TOKEN_EXPIRE_MINUTES=60
IP_HASH_SALT=dev-only-salt-change-me-0123456789

# --- HTTP ---
# Public origin of the API; used to build short URLs and to reject self-referencing links.
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated list of allowed frontend origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For header is trusted.
# Leave empty when the API is exposed directly.
TRUSTED_PROXIES=

# --- Rate limiting (Redis sliding window) ---
# Set to false for load tests: one benchmark machine looks like a single abusive IP.
RATE_LIMIT_ENABLED=true

# --- Click pipeline / caching ---
LINK_CACHE_TTL_SECONDS=3600
STATS_CACHE_TTL_SECONDS=60
WORKER_BATCH_SIZE=100
# Names the worker's in-flight list so a restarted worker resumes its own batch.
# Defaults to the hostname; docker-compose pins it to "worker-1".
# WORKER_ID=worker-1

# --- Geo lookup ---
# Path to MaxMind GeoLite2-City.mmdb, relative to backend/ (see backend/data/README.md).
# Free account required. If the file is missing, country/city are "Unknown".
GEOIP_DB_PATH=data/GeoLite2-City.mmdb

# --- Frontend (Vite; inlined at build time) ---
VITE_API_BASE_URL=http://localhost:8000
# Set to false to hide the "Explore the demo account" button.
VITE_SHOW_DEMO_LOGIN=true
